---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { doctor, seo } from '../data/site';
import { buildSchema, videoSources } from '../lib/schema';
import portrait from '../assets/images/karine-retrato-jaleco.png';
import posterDor from '../assets/video-posters/dor-treino-lesao.png';
import posterCheckup from '../assets/video-posters/checkup-cardiologico.png';
import posterCorrida from '../assets/video-posters/corrida-preparo-prevencao.png';
import posterPalestra from '../assets/story-frames/karine-palestra-authority.jpg';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Inclui no JSON-LD os dados completos (médica, clínica, vídeos e FAQ). Só na home. */
  fullSchema?: boolean;
  /** Página fora do índice (ex.: 404). */
  noindex?: boolean;
}

const {
  title = seo.title,
  description = seo.description,
  path = '/',
  fullSchema: full = false,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);

// Posters já otimizados pelo astro:assets (mesma largura usada nos componentes,
// então o arquivo é reaproveitado e não duplicado).
const posterFiles: Record<string, ImageMetadata> = {
  'dor-treino-lesao': posterDor,
  'checkup-cardiologico': posterCheckup,
  'corrida-preparo-prevencao': posterCorrida,
  'como-foi-palestra': posterPalestra,
};

const videos = full
  ? await Promise.all(
      videoSources.map(async (v) => ({
        ...v,
        poster: (await getImage({ src: posterFiles[v.slug], width: 640 })).src,
      }))
    )
  : [];
const physicianImage = full ? (await getImage({ src: portrait, width: 260 })).src : undefined;

const structuredData = buildSchema({
  site: Astro.site!,
  canonical: canonicalURL,
  title,
  description,
  ogImage: ogImageURL,
  full,
  physicianImage,
  videos,
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={seo.themeColor} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={doctor.name} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={doctor.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
