---
import { doctor, nav, links } from '../data/site';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---
<header class="site-header" id="site-header">
  <div class="wrap">
    <a href="#inicio" class="brand">{doctor.name}</a>

    <nav class="main-nav" aria-label="Navegação principal">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} data-nav-link={item.href.slice(1)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a
        class="btn btn--ghost header-cta"
        href={links.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Agendar consulta pelo WhatsApp (abre em nova aba)"
      >
        <WhatsAppIcon />
        Agendar consulta
      </a>
      <button
        type="button"
        class="menu-toggle"
        id="menu-open-btn"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menu de navegação"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu de navegação">
  <div class="mobile-menu-top">
    <span class="brand">{doctor.name}</span>
    <button type="button" class="menu-close" id="menu-close-btn" aria-label="Fechar menu">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav aria-label="Navegação móvel">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} class="mobile-nav-link">{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="mobile-menu-footer">
    <a
      class="btn btn--on-dark btn--primary"
      href={links.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
    >
      <WhatsAppIcon />
      Agendar consulta
    </a>
  </div>
</div>

<script src="../scripts/header-nav.ts"></script>
