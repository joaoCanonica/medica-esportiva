---
import { Image, getImage } from 'astro:assets';
import { doctor, clinic, links } from '../data/site';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import PinIcon from './icons/PinIcon.astro';
import PlayIcon from './icons/PlayIcon.astro';
import posterCorrida from '../assets/video-posters/corrida-preparo-prevencao.png';

// Vídeo já publicado (mesmo usado em Conteúdos) em vez de imagem estática.
const contactVideo = {
  src: '/videos/corrida-preparo-prevencao.mp4',
  title: 'Corrida, preparo e prevenção',
};
const contactPoster = await getImage({ src: posterCorrida, width: 640 });
---
<section class="section contact" id="contato">
  <div class="wrap contact-layout">
    <div class="contact-copy reveal">
      <span class="eyebrow">Contato</span>
      <h2>Seu movimento merece cuidado, contexto e direção.</h2>
      <p>Entre em contato para conhecer o atendimento da Dra. Karine Bittencourt em Lages.</p>

      <div class="cta-group">
        <a class="btn btn--on-dark btn--primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
          <WhatsAppIcon />
          Agendar pelo WhatsApp
        </a>
        <a class="btn btn--on-dark" href={links.instagram} target="_blank" rel="noopener noreferrer">
          <InstagramIcon />
          Acompanhar no Instagram
        </a>
        <a class="btn btn--on-dark" href={links.googleMaps} target="_blank" rel="noopener noreferrer">
          <PinIcon />
          Abrir rota
        </a>
      </div>

      <div class="contact-details">
        <strong>{clinic.name}</strong>
        <span>{clinic.street} - {clinic.neighborhood}</span>
        <span>{clinic.city} - {clinic.state}, CEP {clinic.postalCode}</span>
        <span>{doctor.registration}</span>
      </div>
    </div>

    <div class="contact-media reveal" style="--reveal-delay: 0.1s">
      <button
        type="button"
        class="watch-trigger media-video-trigger"
        data-video-src={contactVideo.src}
        data-video-title={contactVideo.title}
        data-video-poster={contactPoster.src}
        aria-label={`Assistir vídeo: ${contactVideo.title}`}
      >
        <Image
          src={posterCorrida}
          alt="Dra. Karine Bittencourt falando sobre corrida, preparo e prevenção"
          widths={[420, 640]}
          sizes="(min-width: 900px) 40vw, 90vw"
          loading="lazy"
        />
        <span class="media-play-badge" aria-hidden="true"><PlayIcon /></span>
      </button>
    </div>
  </div>
</section>
