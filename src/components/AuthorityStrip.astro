---
import { Image } from 'astro:assets';
import palestraFrame from '../assets/story-frames/karine-palestra-authority.jpg';
import palestraArt from '../assets/images/karine-palestra.png';
import seminario from '../assets/images/karine-seminario.png';

const tags = [
  'Potência Empreendedora',
  'Educação em saúde',
  'Saúde física e mental',
  'Autocuidado e rotina feminina',
];
---
<section class="section authority">
  <div class="wrap authority-layout">
    <div class="authority-media reveal">
      <div class="authority-media-main">
        <Image
          src={palestraFrame}
          alt="Dra. Karine Bittencourt palestrando sobre saúde"
          widths={[420, 640]}
          sizes="(min-width: 900px) 50vw, 90vw"
          loading="lazy"
        />
      </div>
      <div class="authority-media-doc">
        <Image
          src={palestraArt}
          alt="Arte de divulgação da palestra da Dra. Karine Bittencourt"
          width={200}
          loading="lazy"
        />
      </div>
    </div>

    <div class="authority-copy reveal" style="--reveal-delay: 0.1s">
      <span class="eyebrow">Conhecimento compartilhado</span>
      <h2>Conhecimento que circula.</h2>
      <p>
        Palestras, conversas e ações de educação em saúde aproximam informação médica da rotina
        de diferentes públicos.
      </p>

      <div class="authority-secondary">
        <Image
          src={seminario}
          alt="Dra. Karine Bittencourt em uma ação de educação em saúde"
          widths={[420, 640]}
          sizes="(min-width: 900px) 40vw, 90vw"
          loading="lazy"
        />
      </div>

      <div class="authority-tags">
        {tags.map((tag) => (
          <span class="authority-tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</section>
