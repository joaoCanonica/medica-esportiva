---
import { Image } from 'astro:assets';
import danca from '../assets/images/karine-danca.png';
import consulta from '../assets/images/karine-retrato-jaleco.png';
import palestra from '../assets/story-frames/karine-palestra-mosaico.jpg';
import seminario from '../assets/images/karine-seminario.png';

const items = [
  {
    src: danca,
    alt: 'Dra. Karine Bittencourt dançando',
    label: 'Dança',
    className: 'mosaic-item--main',
  },
  {
    src: consulta,
    alt: 'Retrato profissional da Dra. Karine Bittencourt de jaleco',
    label: 'Consultório',
    className: 'mosaic-item--consulta',
  },
  {
    src: palestra,
    alt: 'Dra. Karine Bittencourt palestrando sobre saúde',
    label: 'Palestras',
    className: 'mosaic-item--palestra',
  },
  {
    src: seminario,
    alt: 'Dra. Karine Bittencourt em uma ação de educação em saúde',
    label: 'Educação em saúde',
    className: 'mosaic-item--seminario',
  },
];
---
<section class="section mosaic">
  <div class="wrap">
    <h2 class="mosaic-title reveal">Corre. Treina. Dança. Ensina. Cuida.</h2>
    <div class="mosaic-grid reveal" style="--reveal-delay: 0.1s">
      {items.map((item) => (
        <figure class:list={['mosaic-item', item.className]}>
          <Image src={item.src} alt={item.alt} loading="lazy" />
          <figcaption class="mosaic-label">{item.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
