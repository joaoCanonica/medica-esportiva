---
import { sports } from '../data/site';

const energyWords = new Set(['Corrida', 'Dança']);
---
<div class="ticker" role="region" aria-label="Modalidades acompanhadas">
  <div class="ticker-track">
    <ul class="ticker-list">
      {sports.map((sport) => (
        <li class:list={['ticker-item', { 'is-energy': energyWords.has(sport) }]}>{sport}</li>
      ))}
    </ul>
    <ul class="ticker-list" aria-hidden="true">
      {sports.map((sport) => (
        <li class:list={['ticker-item', { 'is-energy': energyWords.has(sport) }]}>{sport}</li>
      ))}
    </ul>
  </div>
</div>
