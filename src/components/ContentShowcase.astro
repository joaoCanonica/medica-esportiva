---
import { Image } from 'astro:assets';
import { educationalContent, instagramTeaser, links } from '../data/site';
import InstagramIcon from './icons/InstagramIcon.astro';
import PlayIcon from './icons/PlayIcon.astro';
import posterDor from '../assets/video-posters/dor-treino-lesao.png';
import posterCheckup from '../assets/video-posters/checkup-cardiologico.png';
import posterCorrida from '../assets/video-posters/corrida-preparo-prevencao.png';

const posters: Record<string, ImageMetadata> = {
  'dor-treino-lesao': posterDor,
  'checkup-cardiologico': posterCheckup,
  'corrida-preparo-prevencao': posterCorrida,
};

const featured = educationalContent.find((item) => item.featured)!;
const secondary = educationalContent.filter((item) => !item.featured);
---
<section class="section showcase" id="conteudos">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Conteúdos</span>
      <h2>Informação para cuidar melhor do seu movimento.</h2>
    </div>

    <div class="showcase-grid reveal" style="--reveal-delay: 0.1s">
      <button
        type="button"
        class="showcase-card showcase-card--main watch-trigger"
        data-video-src={featured.videoSrc}
        data-video-title={featured.title}
      >
        <Image
          src={posters[featured.slug]}
          alt={`Imagem de capa do vídeo: ${featured.title}`}
          widths={[420, 640]}
          sizes="(min-width: 860px) 55vw, 92vw"
          loading="lazy"
        />
        {featured.duration && <span class="showcase-duration">{featured.duration}</span>}
        <span class="showcase-card-body">
          <h3>{featured.title}</h3>
          <span class="showcase-play" aria-hidden="true"><PlayIcon /></span>
        </span>
      </button>

      <div class="showcase-secondary">
        {secondary.map((item) => (
          <button
            type="button"
            class="showcase-card showcase-card--secondary watch-trigger"
            data-video-src={item.videoSrc}
            data-video-title={item.title}
          >
            <Image
              src={posters[item.slug]}
              alt={`Imagem de capa do vídeo: ${item.title}`}
              widths={[320, 480]}
              sizes="(min-width: 860px) 38vw, 92vw"
              loading="lazy"
            />
            {item.duration && <span class="showcase-duration">{item.duration}</span>}
            <span class="showcase-card-body">
              <h3>{item.title}</h3>
              <span class="showcase-play" aria-hidden="true"><PlayIcon /></span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <p class="showcase-footer reveal" style="--reveal-delay: 0.15s">
      <InstagramIcon />
      <a href={links.instagram} target="_blank" rel="noopener noreferrer">
        {instagramTeaser}
      </a>
    </p>
  </div>
</section>

<dialog id="video-dialog" class="video-dialog" aria-labelledby="video-dialog-title">
  <div class="video-dialog-inner">
    <div class="video-dialog-head">
      <h2 id="video-dialog-title" class="video-dialog-title">&nbsp;</h2>
      <button type="button" class="video-dialog-close" data-video-close autofocus aria-label="Fechar vídeo">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <div class="video-dialog-body">
      <video id="video-dialog-player" class="video-dialog-player" controls playsinline preload="none"></video>
      <p class="video-dialog-error" id="video-dialog-error" hidden>
        <span>Não foi possível carregar o vídeo agora.</span>
        <span><a href={links.instagram} target="_blank" rel="noopener noreferrer">Assista no Instagram</a>.</span>
      </p>
    </div>
  </div>
</dialog>

<script src="../scripts/video-dialog.ts"></script>
