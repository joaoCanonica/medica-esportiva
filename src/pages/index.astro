---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroExperience from '../components/HeroExperience.astro';
import SportTicker from '../components/SportTicker.astro';
import ApproachStatement from '../components/ApproachStatement.astro';
import PatientJourneys from '../components/PatientJourneys.astro';
import KarineStory from '../components/KarineStory.astro';
import RunningFeature from '../components/RunningFeature.astro';
import ContentShowcase from '../components/ContentShowcase.astro';
import AuthorityStrip from '../components/AuthorityStrip.astro';
import FAQ from '../components/FAQ.astro';
import ContactExperience from '../components/ContactExperience.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
---
<BaseLayout path="/">
  <Header />
  <main id="main">
    <HeroExperience />
    <SportTicker />
    <ApproachStatement />
    <PatientJourneys />
    <KarineStory />
    <RunningFeature />
    <ContentShowcase />
    <AuthorityStrip />
    <FAQ />
    <ContactExperience />
  </main>
  <Footer />
  <MobileCTA />

  <script src="../scripts/reveal.ts"></script>
</BaseLayout>
