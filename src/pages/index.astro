---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Approach from '../components/Approach.astro';
import Recognition from '../components/Recognition.astro';
import ForWhom from '../components/ForWhom.astro';
import Movement from '../components/Movement.astro';
import Expression from '../components/Expression.astro';
import WomenHealth from '../components/WomenHealth.astro';
import Content from '../components/Content.astro';
import Sharing from '../components/Sharing.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
---
<BaseLayout path="/">
  <Header />
  <main id="main">
    <Hero />
    <Approach />
    <Recognition />
    <ForWhom />
    <Movement />
    <Expression />
    <WomenHealth />
    <Content />
    <Sharing />
    <FAQ />
    <FinalCTA />
    <Location />
  </main>
  <Footer />
  <MobileCTA />

  <script src="../scripts/reveal.ts"></script>
</BaseLayout>
